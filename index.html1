<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>Admin</title>
<style>
  body { background:#000; color:rgb(228,219,219); font-family:Arial,sans-serif; margin:0; padding:20px; }
  h1,h2 { text-align:center; }
  .box { max-width:900px; margin:0 auto; }
  input, button, select { background:#111; color:inherit; border:1px solid rgb(228,219,219); border-radius:6px; padding:8px 12px; font-size:14px; }
  button { cursor:pointer; } button:hover { background:rgb(228,219,219); color:#000; }
  table { width:100%; border-collapse:collapse; margin-top:15px; }
  th, td { border:1px solid #555; padding:8px; text-align:center; }
  td.title { text-align:left; }
  .total { font-size:26px; text-align:center; margin:20px 0; }
  .row { display:flex; gap:10px; flex-wrap:wrap; justify-content:center; margin:10px 0; }
  .err { color:#ff7b7b; } .ok { color:#7bff9a; }
  #app { display:none; }
  td input { width:70px; }
</style>
</head>
<body>
<div class="box">

  <!-- Login gate (only a speed bump, see notes) -->
  <div id="gate">
    <h1>Admin</h1>
    <div class="row">
      <input type="password" id="pw" placeholder="Password">
      <button onclick="login()">Enter</button>
    </div>
    <p id="gateMsg" class="err" style="text-align:center"></p>
  </div>

  <div id="app">
    <h1>Video Hours Counter</h1>

    <div class="row">
      <input id="apiKey" placeholder="Google Drive API key" size="40">
      <button onclick="saveKey()">Save key</button>
      <button onclick="loadAll()">Load durations</button>
    </div>

    <div class="row">
      Rounding:
      <select id="mode" onchange="render()">
        <option value="half">Your rule: extra 1-29 min = +30 min, extra 30-59 min = +1 hour (1h20 = 1.5h, 1h40 = 2h)</option>
        <option value="up">Round UP to the next full hour</option>
        <option value="exact">Exact time (no rounding)</option>
      </select>
    </div>

    <p id="status" style="text-align:center"></p>
    <div class="total" id="total"></div>

    <table>
      <thead><tr><th>#</th><th style="text-align:left">Video</th><th>Real time</th><th>Manual (min)</th><th>Counts as</th></tr></thead>
      <tbody id="rows"></tbody>
    </table>
  </div>
</div>

<script>
// ====== EDIT THESE ======
const PASSWORD = "change-me";   // change this!

// Put all your Drive file IDs here (copied from your main page)
const VIDEOS = [
  { title: "Physics - Chapter 1",           id: "1DmDzBC9VsDoary1g83u4nbagNgc1V34j" },
  { title: "Physics - تكملة Chapter 1",      id: "1TA8bJe0qMxSaCeACRZiBftEwbqBSaqXz" },
  { title: "Physics - Chapter 3",           id: "1-gyszB07AXU6EH1CoxeGHekG1TnWK-2c" },
  { title: "Physics - تكملة Chapter 3",      id: "1nMCfx_0whHCS1TeC8U7CsHgW1Rd_an-c" },
  { title: "Physics - تكملة Chapter 3 (2)",  id: "1Ivzni2KKbPcVYT_IAGaVqXre4SsyG1SD" },
  { title: "Physics - تكملة Chapter 2",      id: "1GTblej67RLhe8DVTxZUuc4-POQmSCSrN" },
  { title: "Physics - Chapter 4",           id: "16P2Llbs9cwwfCD7xf_FYIvBVezghZjCA" },
  { title: "Math - المحاضرة الأولى",         id: "1b79YFzuo7pbF93xyF-tqOz3h7w8lP1fw" },
  { title: "Math - Chapter 1.3",            id: "1BCK_mG8OtNe7wUgSQ-xcfd1NBZNPtxjo" },
];
// ========================

const durations = {};   // id -> minutes (from Drive)
const manual = {};      // id -> minutes (typed by you)
try { Object.assign(manual, JSON.parse(localStorage.getItem("manualMins") || "{}")); } catch(e){}

function login() {
  if (document.getElementById("pw").value === PASSWORD) {
    document.getElementById("gate").style.display = "none";
    document.getElementById("app").style.display = "block";
    try { document.getElementById("apiKey").value = localStorage.getItem("driveKey") || ""; } catch(e){}
    render();
  } else {
    document.getElementById("gateMsg").textContent = "Wrong password";
  }
}
document.getElementById("pw").addEventListener("keydown", e => { if (e.key === "Enter") login(); });

function saveKey() {
  try { localStorage.setItem("driveKey", document.getElementById("apiKey").value.trim()); } catch(e){}
  setStatus("Key saved in this browser only.", "ok");
}

function setStatus(msg, cls) {
  const s = document.getElementById("status");
  s.textContent = msg; s.className = cls || "";
}

async function loadAll() {
  const key = document.getElementById("apiKey").value.trim();
  if (!key) { setStatus("Enter your API key first (or type minutes manually).", "err"); return; }
  setStatus("Loading...");
  let failed = 0;
  for (const v of VIDEOS) {
    try {
      const url = `https://www.googleapis.com/drive/v3/files/${v.id}?fields=name,videoMediaMetadata(durationMillis)&supportsAllDrives=true&key=${encodeURIComponent(key)}`;
      const r = await fetch(url);
      const j = await r.json();
      if (j.videoMediaMetadata && j.videoMediaMetadata.durationMillis) {
        durations[v.id] = Number(j.videoMediaMetadata.durationMillis) / 60000;
      } else { failed++; }
    } catch (e) { failed++; }
  }
  render();
  setStatus(failed ? `${failed} video(s) had no duration, type the minutes manually for those.` : "All durations loaded.", failed ? "err" : "ok");
}

function mins(id) {
  if (manual[id] !== undefined && manual[id] !== "") return Number(manual[id]);
  return durations[id];
}

function counted(m) {
  const mode = document.getElementById("mode").value;
  if (m === undefined || isNaN(m)) return null;
  if (mode === "up") return Math.max(1, Math.ceil(m / 60));
  if (mode === "half") { const h = Math.floor(m / 60), rem = m - h * 60; return h + (rem >= 30 ? 1 : (rem > 0 ? 0.5 : 0)); }
  return m / 60;
}

function fmt(m) {
  if (m === undefined || isNaN(m)) return "-";
  const h = Math.floor(m / 60), mm = Math.round(m % 60);
  return h ? `${h}h ${mm}m` : `${mm}m`;
}

function setManual(id, val) {
  manual[id] = val;
  try { localStorage.setItem("manualMins", JSON.stringify(manual)); } catch(e){}
  render();
}

function render() {
  let total = 0, realTotal = 0;
  const tb = document.getElementById("rows");
  tb.innerHTML = "";
  VIDEOS.forEach((v, i) => {
    const m = mins(v.id);
    const c = counted(m);
    if (c !== null) { total += c; realTotal += m; }
    const tr = document.createElement("tr");
    tr.innerHTML = `<td>${i + 1}</td>
      <td class="title">${v.title}</td>
      <td>${fmt(durations[v.id])}</td>
      <td><input type="number" min="0" value="${manual[v.id] ?? ""}" onchange="setManual('${v.id}', this.value)"></td>
      <td>${c === null ? "-" : (Math.round(c * 100) / 100) + " h"}</td>`;
    tb.appendChild(tr);
  });
  document.getElementById("total").innerHTML =
    `Total counted: <b>${Math.round(total * 100) / 100} hours</b><br><small>Real total: ${fmt(realTotal)}</small>`;
}
</script>
</body>
</html>
